{
  "name": "tesla-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --import tsx --test tests/*.test.ts",
    "keys": "node scripts/generate-keys.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node --env-file=.env dist-node/server.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20260911.0-alpha",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.131.1"
  }
}
